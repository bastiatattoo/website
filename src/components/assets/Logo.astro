---
import { Image } from "astro:assets";
import logo from "./logo-small.png";

const { class: className = "", ...rest } = Astro.props;
---

<Image
  class={className}
  {...rest}
  inferSize
  layout="constrained"
  src={logo}
  alt="Graphicaderme Orange & Bastia Tattoo"
/>

